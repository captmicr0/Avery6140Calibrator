<?xml version="1.0" encoding="utf-8"?>
<barcodes:BaseBarcodeView x:Class="AD.API.SampleApplication.Views.Barcodes.OneDimentional.MsiView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:barcodes="clr-namespace:AD.API.SampleApplication.Views.Barcodes" xmlns:tools="clr-namespace:AD.API.SampleApplication.Tools" xmlns:userControls="clr-namespace:AD.API.SampleApplication.Controls.UserControls" Title="MsiView" xmlns:onedimentional="clr-namespace:AD.API.SampleApplication.Views.Barcodes.OneDimentional">
  <Grid Margin="20" IsEnabled="{Binding Path=IsActionAvailable}">
    <FrameworkElement.Resources>
      <ResourceDictionary>
        <tools:BoolInverterConverter x:Key="boolInverterConverter" />
      </ResourceDictionary>
    </FrameworkElement.Resources>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel Orientation="Vertical" Grid.Row="0">
      <Border Style="{StaticResource DefaultBorderStyle}">
        <Grid Name="EnabledGrid">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <Label Name="EnabledLabel" Style="{StaticResource SettingsLabel}" Grid.Column="0">Enabled</Label>
          <RadioButton Name="EnableRadioButton" Style="{StaticResource SettingsRadioButton}" Grid.Column="1" IsChecked="{Binding Path=MsiEnabled, Converter={StaticResource boolInverterConverter}, ConverterParameter=true, Mode=TwoWay}">On</RadioButton>
          <RadioButton Name="DisableRadionButton" Style="{StaticResource SettingsRadioButton}" Grid.Column="2" IsChecked="{Binding Path=MsiEnabled, Converter={StaticResource boolInverterConverter}, ConverterParameter=false, Mode=TwoWay}">Off</RadioButton>
        </Grid>
      </Border>
      <Border Style="{StaticResource DefaultBorderStyle}">
        <Grid Name="Length1Grid">
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <Label Name="Length1Label" Style="{StaticResource SettingsLabel}" Grid.Column="0">Length 1</Label>
          <userControls:CustomSettingsSlider x:Name="Length1SettingsSlider" MinimumValue="0" MaximumValue="99" Grid.Column="1" HorizontalSliderValue="{Binding Path=Length1, Mode=TwoWay}" />
        </Grid>
      </Border>
      <Border Style="{StaticResource DefaultBorderStyle}">
        <Grid Name="Length2Grid">
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <Label Name="Length2Label" Style="{StaticResource SettingsLabel}" Grid.Column="0">Length 2</Label>
          <userControls:CustomSettingsSlider x:Name="Length2SettingsSlider" MinimumValue="0" MaximumValue="99" Grid.Column="1" HorizontalSliderValue="{Binding Path=Length2, Mode=TwoWay}" />
        </Grid>
      </Border>
      <Border Style="{StaticResource DefaultBorderStyle}">
        <Grid Name="CheckSumsEnabledGrid">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <Label Name="CheckSumsEnabledLabel" Style="{StaticResource SettingsLabel}" Grid.Column="0">Two Checksums</Label>
          <RadioButton Name="CheckSumsEnableRadioButton" Style="{StaticResource SettingsRadioButton}" Grid.Column="1" IsChecked="{Binding Path=TwoChecksumsEnabled, Converter={StaticResource boolInverterConverter}, ConverterParameter=true, Mode=TwoWay}">On</RadioButton>
          <RadioButton Name="CheckSumsDisableRadionButton" Style="{StaticResource SettingsRadioButton}" Grid.Column="2" IsChecked="{Binding Path=TwoChecksumsEnabled, Converter={StaticResource boolInverterConverter}, ConverterParameter=false, Mode=TwoWay}">Off</RadioButton>
        </Grid>
      </Border>
      <Border Style="{StaticResource DefaultBorderStyle}">
        <Grid Name="Mod10Mod11EnabledGrid">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <Label Name="Mod10Mod11EnabledLabel" Style="{StaticResource SettingsLabel}" Grid.Column="0">
            <ContentControl.Content>
              <TextBlock TextWrapping="Wrap">Mod10 / Mod11</TextBlock>
            </ContentControl.Content>
          </Label>
          <RadioButton Name="Mod10Mod11EnableRadioButton" Style="{StaticResource SettingsRadioButton}" Grid.Column="1" IsChecked="{Binding Path=Mod10Mod11Enabled, Converter={StaticResource boolInverterConverter}, ConverterParameter=true, Mode=TwoWay}">On</RadioButton>
          <RadioButton Name="Mod10Mod11DisableRadionButton" Style="{StaticResource SettingsRadioButton}" Grid.Column="2" IsChecked="{Binding Path=Mod10Mod11Enabled, Converter={StaticResource boolInverterConverter}, ConverterParameter=false, Mode=TwoWay}">Off</RadioButton>
        </Grid>
      </Border>
      <Border Style="{StaticResource DefaultBorderStyle}">
        <Grid Name="DigitsTransmissionCheckEnabledGrid">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <Label Name="DigitsTransmissionCheckEnabledLabel" Style="{StaticResource SettingsLabel}" Grid.Column="0">
            <ContentControl.Content>
              <TextBlock TextWrapping="Wrap">Check Digits Transmission</TextBlock>
            </ContentControl.Content>
          </Label>
          <RadioButton Name="DigitsTransmissionCheckEnableRadioButton" Style="{StaticResource SettingsRadioButton}" Grid.Column="1" IsChecked="{Binding Path=DigitsTransmissionEnabled, Converter={StaticResource boolInverterConverter}, ConverterParameter=true, Mode=TwoWay}">On</RadioButton>
          <RadioButton Name="DigitsTransmissionCheckDisableRadionButton" Style="{StaticResource SettingsRadioButton}" Grid.Column="2" IsChecked="{Binding Path=DigitsTransmissionEnabled, Converter={StaticResource boolInverterConverter}, ConverterParameter=false, Mode=TwoWay}">Off</RadioButton>
        </Grid>
      </Border>
    </StackPanel>
    <Button Name="BackButton" VerticalAlignment="Bottom" Style="{StaticResource LargeButton}" Grid.Row="1" Click="BackButton_Click">Back</Button>
  </Grid>
</barcodes:BaseBarcodeView>