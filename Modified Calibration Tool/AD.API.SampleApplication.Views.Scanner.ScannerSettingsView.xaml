<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="AD.API.SampleApplication.Views.Scanner.ScannerSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:enumAlias="clr-namespace:AD.API.SampleApplication.Tools.EnumAlias" xmlns:tools="clr-namespace:AD.API.SampleApplication.Tools" xmlns:userControls="clr-namespace:AD.API.SampleApplication.Controls.UserControls" Title="ScannerSettingsView" xmlns:scanner="clr-namespace:AD.API.SampleApplication.Views.Scanner">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <enumAlias:ApiEnumAlias x:Key="apiEnumAlias" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly" IsEnabled="{Binding Path=IsActionAvailable}">
    <Grid Margin="20">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <StackPanel Grid.Row="0">
        <Border Style="{StaticResource DefaultBorderStyle}">
          <Grid Name="ScanModeGrid">
            <FrameworkElement.Resources>
              <ResourceDictionary>
                <tools:EnumBooleanConverter x:Key="enumBooleanConverter" />
              </ResourceDictionary>
            </FrameworkElement.Resources>
            <Grid.RowDefinitions>
              <RowDefinition />
              <RowDefinition />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Label Name="ScanModeLabel" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource SettingsLabel}">Scan mode</Label>
            <RadioButton Name="CompatibleRadioButton" Grid.Row="1" Grid.Column="0" FontSize="14px" IsChecked="{Binding Path=ScannerMode, Converter={StaticResource enumBooleanConverter}, ConverterParameter=Compatible}">Compatible</RadioButton>
            <RadioButton Name="ContinuosRadioButton" Grid.Row="1" Grid.Column="1" FontSize="14px" IsChecked="{Binding Path=ScannerMode, Converter={StaticResource enumBooleanConverter}, ConverterParameter=Continuous}">Continuous</RadioButton>
            <RadioButton Name="MomentaryRadioButton" Grid.Row="1" Grid.Column="2" FontSize="14px" IsChecked="{Binding Path=ScannerMode, Converter={StaticResource enumBooleanConverter}, ConverterParameter=Momentary}">Momentary</RadioButton>
          </Grid>
        </Border>
        <Border Style="{StaticResource DefaultBorderStyle}">
          <Grid Name="TimeoutGrid">
            <Grid.RowDefinitions>
              <RowDefinition />
              <RowDefinition />
            </Grid.RowDefinitions>
            <Label Name="TimeoutLabel" Grid.Row="0" Style="{StaticResource SettingsLabel}">Timeout</Label>
            <userControls:CustomSettingsSlider Grid.Row="1" MinimumValue="0" MaximumValue="99" Margin="5" HorizontalSliderValue="{Binding Path=ScannerTimeout, Mode=TwoWay}" />
          </Grid>
        </Border>
        <Border Style="{StaticResource DefaultBorderStyle}">
          <Grid Name="AimDurationGrid">
            <Grid.RowDefinitions>
              <RowDefinition />
              <RowDefinition />
            </Grid.RowDefinitions>
            <Label Name="AimDurationLabel" Grid.Row="0" Style="{StaticResource SettingsLabel}">Aim duration</Label>
            <userControls:CustomSettingsSlider Grid.Row="1" MinimumValue="0" MaximumValue="99" Margin="5" HorizontalSliderValue="{Binding Path=ScannerAimDuration, Mode=TwoWay}" />
          </Grid>
        </Border>
        <Border Style="{StaticResource DefaultBorderStyle}">
          <Grid Name="LinearSecurityGrid">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Label Name="LinearSecurityLabel" Grid.Row="0" Grid.Column="0" Style="{StaticResource SettingsLabel}">Linear security level</Label>
            <ComboBox Name="SecurityLevelComboBox" SelectedValuePath="Key" DisplayMemberPath="Value" Grid.Row="0" Grid.Column="1" FontSize="15px" Margin="5" ItemsSource="{Binding Source={StaticResource apiEnumAlias}, Path=ScannerLiearSecurityLevelAliases}" SelectedValue="{Binding Path=ScannerLinearSecurity}">
              <ItemsControl.ItemContainerStyle>
                <Style TargetType="{x:Type ComboBoxItem}">
                  <Setter Property="FontSize" Value="20px" />
                </Style>
              </ItemsControl.ItemContainerStyle>
            </ComboBox>
          </Grid>
        </Border>
        <Border Style="{StaticResource DefaultBorderStyle}">
          <Grid Name="BiDirRedundancyGrid">
            <Grid.RowDefinitions>
              <RowDefinition />
              <RowDefinition />
            </Grid.RowDefinitions>
            <Label Name="BiDirRedundancyLabel" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource SettingsLabel}">BiDir Redundancy</Label>
            <userControls:CustomSettingsSlider Grid.Row="1" MinimumValue="1" MaximumValue="4" Margin="5" HorizontalSliderValue="{Binding Path=ScannerBiDirRedun, Mode=TwoWay}" />
          </Grid>
        </Border>
        <Border BorderBrush="#FF808080" BorderThickness="0.5">
          <Grid Name="SelectiveScanGrid">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Label Name="SelectiveScanLabel" Grid.Row="0" Grid.Column="0" Style="{StaticResource SettingsLabel}">Selective scanning</Label>
            <ComboBox Name="SelectiveScanComboBox" Grid.Row="0" Grid.Column="1" FontSize="15px" Margin="5" SelectedIndex="{Binding Path=SelectiveScanOnOff}">
              <ComboBoxItem FontSize="20px" Content="On" />
              <ComboBoxItem FontSize="20px" Content="Off" />
            </ComboBox>
          </Grid>
        </Border>
      </StackPanel>
      <DockPanel Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Stretch">
        <Button Name="BtnGoToBlack" DockPanel.Dock="Bottom" Style="{StaticResource LargeButton}" Click="BtnGoToBlack_Click">Back</Button>
        <Button Name="BtnReset" DockPanel.Dock="Bottom" Style="{StaticResource LargeButton}" FontSize="20px" Command="{Binding Path=ResetToDefaultCommand}">Reset settings</Button>
        <Button Name="BtnBarcodeSettings" DockPanel.Dock="Bottom" Style="{StaticResource LargeButton}" FontSize="20px" Click="BtnBarcodeSettings_Click">Barcode settings</Button>
      </DockPanel>
    </Grid>
  </ScrollViewer>
</Page>