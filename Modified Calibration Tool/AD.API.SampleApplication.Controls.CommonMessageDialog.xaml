<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="AD.API.SampleApplication.Controls.CommonMessageDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Height="300" Width="300" WindowStyle="None" ShowInTaskbar="False" ResizeMode="NoResize" BorderBrush="#FFFF0000" BorderThickness="5" WindowStartupLocation="CenterOwner" xmlns:controls="clr-namespace:AD.API.SampleApplication.Controls;assembly=AD.API.SampleApplication" Title="{Binding Path=ErrorCaption}">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Image Name="MessageImage" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="15, 20, 15, 20" Grid.Row="1" Grid.Column="0" />
    <TextBlock TextAlignment="Center" TextWrapping="NoWrap" Background="#FFFF0000" Foreground="#FFFFFFFF" FontSize="18px" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding Path=ErrorCaption}" />
    <TextBlock TextWrapping="Wrap" Grid.Row="1" Grid.Column="1" Margin="0, 20, 0, 20" FontSize="18px" Text="{Binding Path=ErrorMessage}" />
    <UniformGrid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Rows="1">
      <Button Name="FirstButton" FontSize="30px" Margin="5" Content="{Binding Path=FirstButtonText}" Click="FirstButton_OnClick" />
      <Button Name="SecondButton" FontSize="30px" Margin="5" Content="{Binding Path=SecondButtonText}" Visibility="{Binding Path=SecondButtonVisible}" Click="SecondButton_OnClick" />
    </UniformGrid>
  </Grid>
</Window>