<?xml version="1.0" encoding="utf-8"?>
<barcodes:BaseBarcodeView x:Class="AD.API.SampleApplication.Views.Barcodes.OneDimentional.Code39View" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:barcodes="clr-namespace:AD.API.SampleApplication.Views.Barcodes" xmlns:tools="clr-namespace:AD.API.SampleApplication.Tools" xmlns:userControls="clr-namespace:AD.API.SampleApplication.Controls.UserControls" Title="Code39View" xmlns:onedimentional="clr-namespace:AD.API.SampleApplication.Views.Barcodes.OneDimentional">
  <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly" IsEnabled="{Binding Path=IsActionAvailable}">
    <Grid Margin="20">
      <FrameworkElement.Resources>
        <ResourceDictionary>
          <tools:BoolInverterConverter x:Key="boolInverterConverter" />
        </ResourceDictionary>
      </FrameworkElement.Resources>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <StackPanel Orientation="Vertical" Grid.Row="0">
        <Border Style="{StaticResource DefaultBorderStyle}">
          <Grid Name="EnabledGrid">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*" />
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Label Name="EnabledLabel" Style="{StaticResource SettingsLabel}" Grid.Column="0">Enabled</Label>
            <RadioButton Name="EnableRadioButton" Style="{StaticResource SettingsRadioButton}" Grid.Column="1" IsChecked="{Binding Path=Code39Enabled, Converter={StaticResource boolInverterConverter}, ConverterParameter=true, Mode=TwoWay}">On</RadioButton>
            <RadioButton Name="DisableRadionButton" Style="{StaticResource SettingsRadioButton}" Grid.Column="2" IsChecked="{Binding Path=Code39Enabled, Converter={StaticResource boolInverterConverter}, ConverterParameter=false, Mode=TwoWay}">Off</RadioButton>
          </Grid>
        </Border>
        <Border Style="{StaticResource DefaultBorderStyle}">
          <Grid Name="Length1Grid">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Label Name="Length1Label" Style="{StaticResource SettingsLabel}" Grid.Column="0">Length 1</Label>
            <userControls:CustomSettingsSlider x:Name="Length1SettingsSlider" MinimumValue="0" MaximumValue="99" Grid.Column="1" HorizontalSliderValue="{Binding Path=Length1, Mode=TwoWay}" />
          </Grid>
        </Border>
        <Border Style="{StaticResource DefaultBorderStyle}">
          <Grid Name="Length2Grid">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Label Name="Length2Label" Style="{StaticResource SettingsLabel}" Grid.Column="0">Length 2</Label>
            <userControls:CustomSettingsSlider x:Name="Length2SettingsSlider" MinimumValue="0" MaximumValue="99" Grid.Column="1" HorizontalSliderValue="{Binding Path=Length2, Mode=TwoWay}" />
          </Grid>
        </Border>
        <Border Style="{StaticResource DefaultBorderStyle}">
          <Grid Name="PrefixAEnabledGrid">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*" />
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Label Name="PrefixAEnabledLabel" Style="{StaticResource SettingsLabel}" Grid.Column="0">PrefixA Enabled</Label>
            <RadioButton Name="PrefixAEnableRadioButton" Style="{StaticResource SettingsRadioButton}" Grid.Column="1" IsChecked="{Binding Path=PrefixAEnabled, Converter={StaticResource boolInverterConverter}, ConverterParameter=true, Mode=TwoWay}">On</RadioButton>
            <RadioButton Name="PrefixADisableRadionButton" Style="{StaticResource SettingsRadioButton}" Grid.Column="2" IsChecked="{Binding Path=PrefixAEnabled, Converter={StaticResource boolInverterConverter}, ConverterParameter=false, Mode=TwoWay}">Off</RadioButton>
          </Grid>
        </Border>
        <Border Style="{StaticResource DefaultBorderStyle}">
          <Grid Name="FullAsciiEnabledGrid">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*" />
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Label Name="FullAsciiEnabledLabel" Style="{StaticResource SettingsLabel}" Grid.Column="0">FullAscii Enabled</Label>
            <RadioButton Name="FullAsciiEnableRadioButton" Style="{StaticResource SettingsRadioButton}" Grid.Column="1" IsChecked="{Binding Path=FullAsciiEnabled, Converter={StaticResource boolInverterConverter}, ConverterParameter=true, Mode=TwoWay}">On</RadioButton>
            <RadioButton Name="FullAsciiDisableRadionButton" Style="{StaticResource SettingsRadioButton}" Grid.Column="2" IsChecked="{Binding Path=FullAsciiEnabled, Converter={StaticResource boolInverterConverter}, ConverterParameter=false, Mode=TwoWay}">Off</RadioButton>
          </Grid>
        </Border>
        <Border Style="{StaticResource DefaultBorderStyle}">
          <Grid Name="TrioptricEnabledGrid">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*" />
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Label Name="TrioptricEnabledLabel" Style="{StaticResource SettingsLabel}" Grid.Column="0">Trioptric Enabled</Label>
            <RadioButton Name="TrioptricEnableRadioButton" Style="{StaticResource SettingsRadioButton}" Grid.Column="1" IsChecked="{Binding Path=TrioptricEnabled, Converter={StaticResource boolInverterConverter}, ConverterParameter=true, Mode=TwoWay}">On</RadioButton>
            <RadioButton Name="TriptricDisableRadionButton" Style="{StaticResource SettingsRadioButton}" Grid.Column="2" IsChecked="{Binding Path=TrioptricEnabled, Converter={StaticResource boolInverterConverter}, ConverterParameter=false, Mode=TwoWay}">Off</RadioButton>
          </Grid>
        </Border>
        <Border Style="{StaticResource DefaultBorderStyle}">
          <Grid Name="IntegrityCheckEnabledGrid">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*" />
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Label Name="IntegrityCheckEnabledLabel" Style="{StaticResource SettingsLabel}" Grid.Column="0">Integrity Check</Label>
            <RadioButton Name="IntegrityCheckEnableRadioButton" Style="{StaticResource SettingsRadioButton}" Grid.Column="1" IsChecked="{Binding Path=IntegrityEnabled, Converter={StaticResource boolInverterConverter}, ConverterParameter=true, Mode=TwoWay}">On</RadioButton>
            <RadioButton Name="IntegrityCheckDisableRadionButton" Style="{StaticResource SettingsRadioButton}" Grid.Column="2" IsChecked="{Binding Path=IntegrityEnabled, Converter={StaticResource boolInverterConverter}, ConverterParameter=false, Mode=TwoWay}">Off</RadioButton>
          </Grid>
        </Border>
        <Border Style="{StaticResource DefaultBorderStyle}">
          <Grid Name="ToCode32EnabledGrid">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*" />
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Label Name="ToCode32EnabledLabel" Style="{StaticResource SettingsLabel}" Grid.Column="0">
              <ContentControl.Content>
                <TextBlock TextWrapping="Wrap">Conversion to Code 32</TextBlock>
              </ContentControl.Content>
            </Label>
            <RadioButton Name="ToCode32EnableRadioButton" Style="{StaticResource SettingsRadioButton}" Grid.Column="1" IsChecked="{Binding Path=ToCode32Enabled, Converter={StaticResource boolInverterConverter}, ConverterParameter=true, Mode=TwoWay}">On</RadioButton>
            <RadioButton Name="ToCode32DisableRadionButton" Style="{StaticResource SettingsRadioButton}" Grid.Column="2" IsChecked="{Binding Path=ToCode32Enabled, Converter={StaticResource boolInverterConverter}, ConverterParameter=false, Mode=TwoWay}">Off</RadioButton>
          </Grid>
        </Border>
        <Border Style="{StaticResource DefaultBorderStyle}">
          <Grid Name="CheckDigitsTransmissionEnabledGrid">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*" />
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Label Name="CheckDigitsTransmissionEnabledLabel" Style="{StaticResource SettingsLabel}" Grid.Column="0">
              <ContentControl.Content>
                <TextBlock TextWrapping="Wrap">Check Digits Transmission</TextBlock>
              </ContentControl.Content>
            </Label>
            <RadioButton Name="CheckDigitsTransmissionEnableRadioButton" Style="{StaticResource SettingsRadioButton}" Grid.Column="1" IsChecked="{Binding Path=DigitTransmissionEnabled, Converter={StaticResource boolInverterConverter}, ConverterParameter=true, Mode=TwoWay}">On</RadioButton>
            <RadioButton Name="CheckDigitsTransmissionDisableRadionButton" Style="{StaticResource SettingsRadioButton}" Grid.Column="2" IsChecked="{Binding Path=DigitTransmissionEnabled, Converter={StaticResource boolInverterConverter}, ConverterParameter=false, Mode=TwoWay}">Off</RadioButton>
          </Grid>
        </Border>
      </StackPanel>
      <Button Name="BackButton" VerticalAlignment="Bottom" Style="{StaticResource LargeButton}" Grid.Row="1" Click="BackButton_Click">Back</Button>
    </Grid>
  </ScrollViewer>
</barcodes:BaseBarcodeView>