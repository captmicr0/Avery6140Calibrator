<?xml version="1.0" encoding="utf-8"?>
<barcodes:BaseBarcodeView x:Class="AD.API.SampleApplication.Views.Barcodes.TwoDimentional.MaxiCodeView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:barcodes="clr-namespace:AD.API.SampleApplication.Views.Barcodes" xmlns:tools="clr-namespace:AD.API.SampleApplication.Tools" Title="MaxiCodeView" xmlns:twodimentional="clr-namespace:AD.API.SampleApplication.Views.Barcodes.TwoDimentional">
  <Grid Margin="20" IsEnabled="{Binding Path=IsActionAvailable}">
    <FrameworkElement.Resources>
      <ResourceDictionary>
        <tools:BoolInverterConverter x:Key="boolInverterConverter" />
      </ResourceDictionary>
    </FrameworkElement.Resources>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel Orientation="Vertical" Grid.Row="0">
      <Border Style="{StaticResource DefaultBorderStyle}">
        <Grid Name="EnabledGrid">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <Label Name="EnabledLabel" Style="{StaticResource SettingsLabel}" Grid.Column="0">Enabled</Label>
          <RadioButton Name="EnableRadioButton" Style="{StaticResource SettingsRadioButton}" Grid.Column="1" IsChecked="{Binding Path=MaxiCodeEnabled, Converter={StaticResource boolInverterConverter}, ConverterParameter=true, Mode=TwoWay}">On</RadioButton>
          <RadioButton Name="DisableRadionButton" Style="{StaticResource SettingsRadioButton}" Grid.Column="2" IsChecked="{Binding Path=MaxiCodeEnabled, Converter={StaticResource boolInverterConverter}, ConverterParameter=false, Mode=TwoWay}">Off</RadioButton>
        </Grid>
      </Border>
    </StackPanel>
    <Button Name="BackButton" VerticalAlignment="Bottom" Style="{StaticResource LargeButton}" Grid.Row="1" Click="BackButton_Click">Back</Button>
  </Grid>
</barcodes:BaseBarcodeView>