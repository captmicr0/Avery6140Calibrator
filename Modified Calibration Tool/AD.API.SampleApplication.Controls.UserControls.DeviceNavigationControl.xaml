<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="AD.API.SampleApplication.Controls.UserControls.DeviceNavigationControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:usercontrols="clr-namespace:AD.API.SampleApplication.Controls.UserControls;assembly=AD.API.SampleApplication">
  <Grid Name="LayoutGrid">
    <Grid.ColumnDefinitions>
      <ColumnDefinition />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition />
    </Grid.ColumnDefinitions>
    <Button Name="BtnPrevious" Width="40" Height="40" FontSize="25px" FontWeight="Bold" HorizontalAlignment="Left" Grid.Column="0" Style="{StaticResource ImageButton}" Padding="0, 0, 0, 10" Visibility="{Binding Path=IsEnabled, Converter={StaticResource BoolToVis}, RelativeSource={RelativeSource Mode=Self}}" Command="{Binding Path=CommandPrevious}">&lt;</Button>
    <Label Name="DeviceSerialLabel" Grid.Column="1" FontSize="20px" VerticalAlignment="Center" Content="{Binding Path=SelectedDeviceSerialValue}" />
    <Button Name="BtnNext" Width="40" Height="40" FontSize="25px" FontWeight="Bold" HorizontalAlignment="Right" Grid.Column="2" Style="{StaticResource ImageButton}" Padding="0, 0, 0, 10" Visibility="{Binding Path=IsEnabled, Converter={StaticResource BoolToVis}, RelativeSource={RelativeSource Mode=Self}}" Command="{Binding Path=CommandNext}">&gt;</Button>
  </Grid>
</UserControl>