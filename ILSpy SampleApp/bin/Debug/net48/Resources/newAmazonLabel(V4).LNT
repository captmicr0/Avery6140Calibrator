<?xml version="1.0" ?>
<Job>
  <Energy>Normal</Energy>
  <Quantity>1</Quantity>
  <LabelSize units="Inches" length="1.000" width="1.900" />
  <Command>Print</Command>
  <Image id="AmazonNew" version="1">
    <ImageSize units="inches" x="0.000" y="0.150" height="0.850" width="1.900" origin="BottomLeft" />
    <Presentation>0</Presentation>
    <Fields count="3">
      <TextField id="sort_zone">
        <Volatile>1</Volatile>
        <BoundingBox units="Inches" x="0.000" y="0.35" height="0.50" width="1.9" />
        <Font pointsizeheight="34" pointsizewidth="30" weight="800">Roboto Bold</Font>
        <HorizontalJustification>Center</HorizontalJustification>
        <Data min="0" max="10"></Data>
      </TextField>
      <TextField id="route_code">
        <Volatile>1</Volatile>
        <BoundingBox units="Inches" x="0.10" y="0.12" height="0.280" width="1.70" />
        <Font pointsizeheight="20" pointsizewidth="18">Helvetica Neue</Font>
        <DrawMode>Transparent</DrawMode>
        <HorizontalJustification>Center</HorizontalJustification>
        <Data min="0" max="8"></Data>
      </TextField>
      <TextField id="tracking_number">
        <Volatile>1</Volatile>
        <BoundingBox units="Inches" x="0.10" y="0.01" height="0.125" width="1.70" />
        <Font pointsizeheight="8">Helvetica Neue</Font>
        <HorizontalJustification>Center</HorizontalJustification>
        <Data></Data>
      </TextField>
    </Fields>
  </Image>
</Job>

