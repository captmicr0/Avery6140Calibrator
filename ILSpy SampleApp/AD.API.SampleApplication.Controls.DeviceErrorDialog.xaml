<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="AD.API.SampleApplication.Controls.DeviceErrorDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Height="400" Width="300" WindowStyle="None" ShowInTaskbar="False" ResizeMode="NoResize" BorderBrush="#FFFF0000" BorderThickness="5" WindowStartupLocation="CenterOwner" xmlns:controls="clr-namespace:AD.API.SampleApplication.Controls;assembly=AD.API.SampleApplication" Title="{Binding Path=ErrorCaption}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock TextAlignment="Center" TextWrapping="NoWrap" Background="#FFFF0000" Foreground="#FFFFFFFF" FontSize="18px" Grid.Row="0" Text="{Binding Path=ErrorCaption}" />
    <TextBlock TextWrapping="Wrap" Margin="40, 20" Grid.Row="1" FontSize="18px" Text="{Binding Path=ErrorMessage}" />
    <UniformGrid Grid.Row="2" Columns="1">
      <Button Name="ClearErrorButton" FontSize="30px" Margin="3, 5" Click="ClearErrorButton_Click">Clear error</Button>
      <Button Name="AbortErrorButton" FontSize="30px" Margin="3, 5" Click="AbortErrorButton_Click">Abort error</Button>
      <Button Name="IgnoreErrorButton" FontSize="30px" Margin="3, 5" Click="IgnoreErrorButton_Click">Ignore error</Button>
    </UniformGrid>
  </Grid>
</Window>