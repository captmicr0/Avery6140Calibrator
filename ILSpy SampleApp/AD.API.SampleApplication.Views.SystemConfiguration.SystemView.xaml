<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="AD.API.SampleApplication.Views.SystemConfiguration.SystemView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:userControls="clr-namespace:AD.API.SampleApplication.Controls.UserControls" Title="SystemView" xmlns:systemconfiguration="clr-namespace:AD.API.SampleApplication.Views.SystemConfiguration">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.IsSharedSizeScope="True" PanningMode="VerticalOnly" IsEnabled="{Binding Path=IsActionAvailable}">
    <Grid Margin="20">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <StackPanel Grid.Row="0" Orientation="Vertical">
        <Border Style="{StaticResource DefaultBorderStyle}">
          <Grid Name="DeviceModelGrid">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Label Name="DeviceModelLabel" Grid.Row="0" Grid.Column="0" Style="{StaticResource SettingsLabel}">Device model:</Label>
            <Label Name="DeviceModelValueLabel" Grid.Row="0" Grid.Column="1" Style="{StaticResource SettingsLabel}" HorizontalAlignment="Center" Content="{Binding Path=DeviceModel}" />
          </Grid>
        </Border>
        <Border Style="{StaticResource DefaultBorderStyle}">
          <Grid Name="DeviceStatusGrid">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Label Name="DeviceStatusLabel" Grid.Row="0" Grid.Column="0" Style="{StaticResource SettingsLabel}">Status:</Label>
            <Label Name="DeviceStatusValueLabel" Grid.Row="0" Grid.Column="1" Style="{StaticResource SettingsLabel}" HorizontalAlignment="Center" Content="{Binding Path=DeviceStatus}" />
          </Grid>
        </Border>
        <Border Style="{StaticResource DefaultBorderStyle}">
          <Grid Name="BatteryLevelGrid">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Label Name="BatteryLevelLabel" Grid.Row="0" Grid.Column="0" Style="{StaticResource SettingsLabel}">Battery level:</Label>
            <Label Name="BatteryLevelValueLabel" Grid.Row="0" Grid.Column="1" Style="{StaticResource SettingsLabel}" HorizontalAlignment="Right" Content="{Binding Path=DeviceBatteryLevel}" />
            <ProgressBar Name="BatteryLevelProgressBar" Grid.Row="0" Grid.Column="2" Margin="10, 5, 5, 5" Minimum="0" Maximum="100" Value="{Binding Path=DeviceBatteryLevel, Mode=OneWay}" />
          </Grid>
        </Border>
        <Border Style="{StaticResource DefaultBorderStyle}">
          <Grid Name="BatteryVoltageGrid">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Label Name="BatteryVoltageLabel" Grid.Row="0" Grid.Column="0" Style="{StaticResource SettingsLabel}">Battery voltage:</Label>
            <Label Name="BatteryVoltageValueLabel" Grid.Row="0" Grid.Column="1" Style="{StaticResource SettingsLabel}" HorizontalAlignment="Center" Content="{Binding Path=DeviceBatteryVoltage}" />
          </Grid>
        </Border>
        <Border Style="{StaticResource DefaultBorderStyle}">
          <Grid Name="FirmwareGrid">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Label Name="FirmwareLabel" Grid.Row="0" Grid.Column="0" Style="{StaticResource SettingsLabel}">Firmware:</Label>
            <Label Name="FirmwareValueLabel" Grid.Row="0" Grid.Column="1" Style="{StaticResource SettingsLabel}" HorizontalAlignment="Center" Content="{Binding Path=DeviceFirmwareVersion}" />
          </Grid>
        </Border>
        <Border Style="{StaticResource DefaultBorderStyle}">
          <Grid Name="CdilGrid">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Label Name="CdilLabel" Grid.Row="0" Grid.Column="0" Style="{StaticResource SettingsLabel}">CDIL:</Label>
            <Label Name="CdilValueLabel" Grid.Row="0" Grid.Column="1" Style="{StaticResource SettingsLabel}" HorizontalAlignment="Center" Content="{Binding Path=CdilVersion}" />
          </Grid>
        </Border>
        <Border Style="{StaticResource DefaultBorderStyle}">
          <Grid Name="DeviceComponentsGrid">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Label Name="DeviceComponentsLabel" Grid.Row="0" Grid.Column="0" Style="{StaticResource SettingsLabel}">
              <ContentControl.Content>
                <TextBlock TextWrapping="Wrap">Device components are:</TextBlock>
              </ContentControl.Content>
            </Label>
            <Label Name="DeviceComponentsValueLabel" Grid.Row="0" Grid.Column="1" Style="{StaticResource SettingsLabel}" HorizontalAlignment="Center" Content="{Binding Path=DeviceComponents}" />
          </Grid>
        </Border>
        <Border Style="{StaticResource DefaultBorderStyle}">
          <Grid Name="AppVersionGrid">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Label Name="AppVersionLabel" Grid.Row="0" Grid.Column="0" Style="{StaticResource SettingsLabel}">App version:</Label>
            <Label Name="AppVersionValueLabel" Grid.Row="0" Grid.Column="1" Style="{StaticResource SettingsLabel}" HorizontalAlignment="Center" Content="{Binding Path=ApplicationVersion}" />
          </Grid>
        </Border>
        <Border Style="{StaticResource DefaultBorderStyle}">
          <Grid Name="FeedCalbackGrid">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition SharedSizeGroup="ComboBoxSizeGroup" Width="Auto" />
            </Grid.ColumnDefinitions>
            <Label Name="FeedCallbackLabel" Grid.Row="0" Grid.Column="0" Style="{StaticResource SettingsLabel}">
              <ContentControl.Content>
                <TextBlock TextWrapping="Wrap">Feed button callback</TextBlock>
              </ContentControl.Content>
            </Label>
            <ComboBox Name="FeedCallbackComboBox" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="5" MinWidth="100px" FontSize="15px" SelectedIndex="{Binding Path=FeedButtonOnOff, ValidatesOnExceptions=True}">
              <ComboBoxItem FontSize="20px" Content="On" />
              <ComboBoxItem FontSize="20px" Content="Off" />
            </ComboBox>
          </Grid>
        </Border>
        <Border Style="{StaticResource DefaultBorderStyle}">
          <Grid Name="TriggerCallback">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition SharedSizeGroup="ComboBoxSizeGroup" Width="Auto" />
            </Grid.ColumnDefinitions>
            <Label Name="TriggerCallbackLabel" Grid.Row="0" Grid.Column="0" Style="{StaticResource SettingsLabel}">
              <ContentControl.Content>
                <TextBlock TextWrapping="Wrap">Trigger mode of the device</TextBlock>
              </ContentControl.Content>
            </Label>
            <ComboBox Name="TriggerCallbackComboBox" Grid.Row="0" Grid.Column="1" Margin="5" HorizontalAlignment="Stretch" VerticalAlignment="Center" FontSize="15px" MinWidth="100px" ItemsSource="{Binding Path=TriggerModeValues}" SelectedItem="{Binding Path=SelectedTriggerMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}">
              <ItemsControl.ItemContainerStyle>
                <Style TargetType="{x:Type ComboBoxItem}">
                  <Setter Property="FontSize" Value="20px" />
                </Style>
              </ItemsControl.ItemContainerStyle>
            </ComboBox>
          </Grid>
        </Border>
        <Border Style="{StaticResource DefaultBorderStyle}">
          <Grid Name="VolumeSettingsGrid">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Label Name="VolumeLabel" Grid.Column="0" Style="{StaticResource SettingsLabel}">
              <ContentControl.Content>
                <TextBlock TextWrapping="Wrap">Volume</TextBlock>
              </ContentControl.Content>
            </Label>
            <userControls:CustomSettingsSlider x:Name="VolumeCustomSlider" Grid.Column="1" MaximumValue="20" MinimumValue="0" HorizontalSliderValue="{Binding Path=DeviceVolume, Mode=TwoWay, ValidatesOnExceptions=True}" />
          </Grid>
        </Border>
        <Border Style="{StaticResource DefaultBorderStyle}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition SharedSizeGroup="ComboBoxSizeGroup" Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Name="PlaySoundButton" Grid.Column="0" FontSize="18px" Margin="5" Command="{Binding Path=PlaySoundCommand}">Play Sound</Button>
            <userControls:NumericUpDown Grid.Column="1" Margin="5" MinimumValue="1" MaximumValue="8" IndicatorValue="{Binding Path=SelectedRepeatCount, Mode=TwoWay}" />
            <ComboBox Name="SoundsComboBox" Grid.Column="2" Margin="5" FontSize="15px" HorizontalAlignment="Stretch" VerticalAlignment="Center" VerticalContentAlignment="Center" ItemsSource="{Binding Path=AvailableSoundsArray}" SelectedItem="{Binding Path=SelectedAvailableSound}">
              <ItemsControl.ItemContainerStyle>
                <Style TargetType="{x:Type ComboBoxItem}">
                  <Setter Property="FontSize" Value="20px" />
                </Style>
              </ItemsControl.ItemContainerStyle>
            </ComboBox>
          </Grid>
        </Border>
        <Border Style="{StaticResource DefaultBorderStyle}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
          </Grid>
        </Border>
      </StackPanel>
      <DockPanel Grid.Row="1" VerticalAlignment="Bottom">
        <Button Name="BtnGoToBlack" DockPanel.Dock="Bottom" Style="{StaticResource LargeButton}" Click="BtnGoToBlack_Click">Back</Button>
        <Button Name="BtnReset" DockPanel.Dock="Bottom" Style="{StaticResource LargeButton}" FontSize="20px" Command="{Binding Path=ResetToDefaultCommand}">Reset all parameters to default</Button>
      </DockPanel>
    </Grid>
  </ScrollViewer>
</Page>