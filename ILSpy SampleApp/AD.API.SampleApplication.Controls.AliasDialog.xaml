<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="AD.API.SampleApplication.Controls.AliasDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Height="300" Width="300" WindowStyle="None" ShowInTaskbar="False" ResizeMode="NoResize" BorderBrush="#FFFF0000" BorderThickness="5" WindowStartupLocation="CenterOwner" xmlns:controls="clr-namespace:AD.API.SampleApplication.Controls;assembly=AD.API.SampleApplication" Title="{Binding Path=ErrorCaption}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ControlTemplate x:Key="TextBoxTemplate" TargetType="{x:Type TextBox}">
        <Grid>
          <TextBox Padding="5" Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource TemplatedParent}}" />
          <TextBlock Name="UserMessage" HorizontalAlignment="Left" Text="Please enter the resource alias" Padding="5" Margin="5,0,5,0" Foreground="#FF808080" FontStyle="Italic" IsHitTestVisible="False" Visibility="Hidden" />
        </Grid>
        <ControlTemplate.Triggers>
          <MultiTrigger>
            <MultiTrigger.Conditions>
              <Condition Property="TextBox.Text" Value="" />
              <Condition Property="UIElement.IsKeyboardFocusWithin" Value="False" />
            </MultiTrigger.Conditions>
            <Setter TargetName="UserMessage" Property="UIElement.Visibility" Value="Visible" />
          </MultiTrigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock VerticalAlignment="Bottom" TextAlignment="Center" TextWrapping="NoWrap" Foreground="#FFFFFFFF" Background="#FFFF0000" FontSize="18px" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="Setting resource alias" />
    <TextBox Template="{StaticResource TextBoxTemplate}" VerticalAlignment="Stretch" TextWrapping="Wrap" Grid.Row="1" Grid.Column="1" Margin="10" FontSize="18px" BorderBrush="#FFD3D3D3" Text="{Binding Path=ResourceAlias}" GotFocus="TextBox_GotFocus" />
    <UniformGrid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Rows="1" Height="50">
      <Button Name="Cancel" FontSize="30px" Margin="5" Click="Cancel_Click">Cancel</Button>
      <Button Name="Ok" FontSize="30px" Margin="5" Click="Ok_Click">Ok</Button>
    </UniformGrid>
  </Grid>
</Window>