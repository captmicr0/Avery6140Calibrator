<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <AssemblyName>RyansUnlockedAD6140Tool</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <OutputType>WinExe</OutputType>
	<UseWindowsForms>true</UseWindowsForms>
    <UseWPF>True</UseWPF>
    <TargetFramework>net48</TargetFramework>
    <Prefer32Bit>True</Prefer32Bit>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <RootNamespace />
  </PropertyGroup>
  <ItemGroup>
	<Resource Include="icon.ico" />
    <Page Remove="AD.API.SampleApplication.App.xaml" />
    <ApplicationDefinition Include="AD.API.SampleApplication.App.xaml" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="PresentationCore" />
    <Reference Include="WindowsBase" />
    <Reference Include="AD.API.Win8Desktop">
      <HintPath>..\AD.API.SampleApplication\AD.API.Win8Desktop.dll</HintPath>
    </Reference>
    <Reference Include="NLog">
      <HintPath>..\AD.API.SampleApplication\NLog.dll</HintPath>
    </Reference>
    <Reference Include="System.Core" />
    <Reference Include="System.Management" />
    <Reference Include="Newtonsoft.Json">
      <HintPath>..\AD.API.SampleApplication\Newtonsoft.Json.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="WindowsInput">
      <HintPath>..\AD.API.SampleApplication\WindowsInput.dll</HintPath>
    </Reference>
	 <PackageReference Include="MahApps.Metro" Version="2.4.9" />
  </ItemGroup>
</Project>