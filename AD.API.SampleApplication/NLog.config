<?xml version="1.0" encoding="utf-8"?>

<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true" throwExceptions="true" internalLogLevel="Warn" internalLogFile="${basedir}/logs/NLogInternal.log">
  <time type="AccurateUTC" />
  <targets>
    <target name="file"
            xsi:type="File"
            layout="${longdate:univarsalTime=true} | ${event-context:item=level-num} - ${level} | ${logger} | ${message} | ${event-context:item=type} | ${event-context:item=value} | Context Info -> User ID: ${event-context:item=user-id}, Session ID: ${event-context:item=user-session-id}, Log session ID: ${event-context:item=log-session-id}, AppName: ${event-context:item=app-name}, AppVersion: ${event-context:item=app-version}."
            fileName="${basedir}/logs/Application/ApplicationLog.txt"
            archiveFileName="${basedir}/logs/Application/ApplicationLog.{#}.log"
            archiveAboveSize="1048576"
            archiveNumbering="Sequence"
            concurrentWrites="true"
            keepFileOpen="false"
            encoding="utf-8" />
    <target name="csv"
            xsi:type="File"
            fileName="${basedir}/logs/Usage/UsageAuditLog.csv"
            archiveFileName="${basedir}/logs/Usage/UsageAuditLog.{#}.csv"
            archiveAboveSize="1048576"
            archiveNumbering="Sequence"
            concurrentWrites="true"
            keepFileOpen="false"
            encoding="utf-8" >
      <layout xsi:type="CSVLayout">
        <withHeader>False</withHeader>
        <column name="StartTime" layout="${event-context:item=start-time}" />
        <column name="EndTime" layout="${event-context:item=end-time}" />
        <column name="ActionType" layout="${event-context:item=action-type}" />
        <column name="ActionName" layout="${event-context:item=action-name}" />
        <column name="ActionDescription" layout="${event-context:item=action-description}" />
        <column name="UserId" layout="${event-context:item=user-id}" />
      </layout>
    </target>
    <target name="metrics"
            xsi:type="File"
            fileName="${basedir}/logs/Metrics/MetricsAuditLog.csv"
            archiveFileName="${basedir}/logs/Metrics/MetricsAuditLog.{#}.csv"
            archiveAboveSize="1048576"
            archiveNumbering="Sequence"
            concurrentWrites="true"
            keepFileOpen="false"
            encoding="utf-8" >
      <layout xsi:type="CSVLayout">
        <withHeader>True</withHeader>
        <column name="Date" layout="${date:univarsalTime=true:format=yyyy-MM-dd}" />
        <column name="Time" layout="${date:univarsalTime=true:format=HH\:mm\:ss.ffff}" />
        <column name="ActionType" layout="${event-context:item=action-type}" />
        <column name="TBA" layout="${event-context:item=tba}" />
        <column name="SortZone" layout="${event-context:item=sort-zone}" />
        <column name="RouteCode" layout="${event-context:item=route-code}" />
        <column name="CapturedDuration" layout="${event-context:item=captured-duration}" />
        <column name="ErrorCode" layout="${event-context:item=error-code}" />
        <column name="message" layout="${event-context:item=message}" />
      </layout>
    </target>
  </targets>

  <rules>
    <logger name="FileLogger" minlevel="Trace" writeTo="file" />
    <logger name="CsvLogger" minlevel="Trace" writeTo="csv" />
    <logger name="MetricsLogger" minlevel="Trace" writeTo="metrics" />
  </rules>
</nlog>