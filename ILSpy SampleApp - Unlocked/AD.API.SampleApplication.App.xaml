<?xml version="1.0" encoding="utf-8"?>
<Application x:Class="AD.API.SampleApplication.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sampleapplication="clr-namespace:AD.API.SampleApplication;assembly=AD.API.SampleApplication" StartupUri="AD.API.SampleApplication.MainWindow.xaml">
  <Application.Resources>
    <ResourceDictionary>
      <Style x:Key="LargeButton" BasedOn="{StaticResource {x:Type Button}}" TargetType="{x:Type Button}">
        <Setter Property="Height" Value="60" />
        <Setter Property="FontSize" Value="30px" />
        <Setter Property="Margin" Value="0, 5, 0, 5" />
      </Style>
      <Style x:Key="SmallButton" BasedOn="{StaticResource {x:Type Button}}" TargetType="{x:Type Button}">
        <Setter Property="FontSize" Value="18px" />
        <Setter Property="Margin" Value="10, 5, 10, 5" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
      <Style x:Key="LargeLabel" BasedOn="{StaticResource {x:Type Label}}" TargetType="{x:Type Label}">
        <Setter Property="FontSize" Value="20px" />
      </Style>
      <Style x:Key="SettingsLabel" BasedOn="{StaticResource {x:Type Label}}" TargetType="{x:Type Label}">
        <Setter Property="FontSize" Value="15px" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
      <Style x:Key="BarcodeListViewLeftButton" BasedOn="{StaticResource {x:Type Button}}" TargetType="{x:Type Button}">
        <Setter Property="FontSize" Value="25px" />
        <Setter Property="Margin" Value="0, 0, 5, 10" />
      </Style>
      <Style x:Key="BarcodeListViewRightButton" BasedOn="{StaticResource {x:Type Button}}" TargetType="{x:Type Button}">
        <Setter Property="FontSize" Value="25px" />
        <Setter Property="Margin" Value="5, 0, 0, 10" />
      </Style>
      <Style x:Key="SettingsRadioButton" BasedOn="{StaticResource {x:Type RadioButton}}" TargetType="{x:Type RadioButton}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="15px" />
      </Style>
      <Style x:Key="SettingsSliderHorizontal" BasedOn="{StaticResource {x:Type Slider}}" TargetType="{x:Type Slider}">
        <Setter Property="Slider.Orientation" Value="Horizontal" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Slider.IsMoveToPointEnabled" Value="True" />
        <Setter Property="Slider.IsSnapToTickEnabled" Value="True" />
        <Setter Property="RangeBase.SmallChange" Value="1" />
      </Style>
      <BooleanToVisibilityConverter x:Key="BoolToVis" />
      <Style x:Key="ImageButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Static ToolBar.ButtonStyleKey}}">
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Button}">
              <Border Name="border" BorderThickness="{TemplateBinding Control.BorderThickness}" Padding="{TemplateBinding Control.Padding}" BorderBrush="{TemplateBinding Control.BorderBrush}" CornerRadius="5" Background="{TemplateBinding Control.Background}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter Property="BorderBrush" Value="#FFDCDCDC" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="UIElement.Opacity" Value="0.25" />
                  <Setter Property="BorderBrush" Value="#00FFFFFF" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="DefaultBorderStyle" TargetType="{x:Type Border}">
        <Setter Property="Margin" Value="0, 0, 0, 10" />
        <Setter Property="BorderBrush" Value="#FF808080" />
        <Setter Property="BorderThickness" Value="0.5" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>