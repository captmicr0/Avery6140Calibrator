<?xml version="1.0" encoding="utf-8"?>
<barcodes:BaseBarcodeView x:Class="AD.API.SampleApplication.Views.Barcodes.OneDimentional.UpcView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:barcodes="clr-namespace:AD.API.SampleApplication.Views.Barcodes" xmlns:enumAlias="clr-namespace:AD.API.SampleApplication.Tools.EnumAlias" xmlns:tools="clr-namespace:AD.API.SampleApplication.Tools" xmlns:userControls="clr-namespace:AD.API.SampleApplication.Controls.UserControls" Title="UpcView" xmlns:onedimentional="clr-namespace:AD.API.SampleApplication.Views.Barcodes.OneDimentional">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <enumAlias:ApiEnumAlias x:Key="apiEnumAlias" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly" IsEnabled="{Binding Path=IsActionAvailable}">
    <Grid Margin="20">
      <FrameworkElement.Resources>
        <ResourceDictionary>
          <tools:BoolInverterConverter x:Key="boolInverterConverter" />
        </ResourceDictionary>
      </FrameworkElement.Resources>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <StackPanel Orientation="Vertical" Grid.Row="0">
        <Border Style="{StaticResource DefaultBorderStyle}">
          <Grid Name="EnabledGrid">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*" />
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Label Name="EnabledLabel" Style="{StaticResource SettingsLabel}" Grid.Column="0">Enabled</Label>
            <RadioButton Name="EnableRadioButton" Style="{StaticResource SettingsRadioButton}" Grid.Column="1" IsChecked="{Binding Path=UpcEnabled, Converter={StaticResource boolInverterConverter}, ConverterParameter=true, Mode=TwoWay}">On</RadioButton>
            <RadioButton Name="DisableRadionButton" Style="{StaticResource SettingsRadioButton}" Grid.Column="2" IsChecked="{Binding Path=UpcEnabled, Converter={StaticResource boolInverterConverter}, ConverterParameter=false, Mode=TwoWay}">Off</RadioButton>
          </Grid>
        </Border>
        <Border Style="{StaticResource DefaultBorderStyle}">
          <Grid Name="UpceEnabledGrid">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*" />
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Label Name="UpceEnabledLabel" Style="{StaticResource SettingsLabel}" Grid.Column="0">UPCE Enabled</Label>
            <RadioButton Name="UpceEnableRadioButton" Style="{StaticResource SettingsRadioButton}" Grid.Column="1" IsChecked="{Binding Path=UpceEnabled, Converter={StaticResource boolInverterConverter}, ConverterParameter=true, Mode=TwoWay}">On</RadioButton>
            <RadioButton Name="UpceDisableRadionButton" Style="{StaticResource SettingsRadioButton}" Grid.Column="2" IsChecked="{Binding Path=UpceEnabled, Converter={StaticResource boolInverterConverter}, ConverterParameter=false, Mode=TwoWay}">Off</RadioButton>
          </Grid>
        </Border>
        <Border Style="{StaticResource DefaultBorderStyle}">
          <Grid Name="Upce1EnabledGrid">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*" />
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Label Name="Upce1EnabledLabel" Style="{StaticResource SettingsLabel}" Grid.Column="0">UPCE1 Enabled</Label>
            <RadioButton Name="Upce1EnableRadioButton" Style="{StaticResource SettingsRadioButton}" Grid.Column="1" IsChecked="{Binding Path=Upce1Enabled, Converter={StaticResource boolInverterConverter}, ConverterParameter=true, Mode=TwoWay}">On</RadioButton>
            <RadioButton Name="Upce1DisableRadionButton" Style="{StaticResource SettingsRadioButton}" Grid.Column="2" IsChecked="{Binding Path=Upce1Enabled, Converter={StaticResource boolInverterConverter}, ConverterParameter=false, Mode=TwoWay}">Off</RadioButton>
          </Grid>
        </Border>
        <Border Style="{StaticResource DefaultBorderStyle}">
          <Grid Name="Ean8EnabledGrid">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*" />
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Label Name="Ean8EnabledLabel" Style="{StaticResource SettingsLabel}" Grid.Column="0">EAN 8 Enabled</Label>
            <RadioButton Name="Ean8EnableRadioButton" Style="{StaticResource SettingsRadioButton}" Grid.Column="1" IsChecked="{Binding Path=Ean8Enabled, Converter={StaticResource boolInverterConverter}, ConverterParameter=true, Mode=TwoWay}">On</RadioButton>
            <RadioButton Name="Ean8DisableRadionButton" Style="{StaticResource SettingsRadioButton}" Grid.Column="2" IsChecked="{Binding Path=Ean8Enabled, Converter={StaticResource boolInverterConverter}, ConverterParameter=false, Mode=TwoWay}">Off</RadioButton>
          </Grid>
        </Border>
        <Border Style="{StaticResource DefaultBorderStyle}">
          <Grid Name="Ean13EnabledGrid">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*" />
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Label Name="Ean13EnabledLabel" Style="{StaticResource SettingsLabel}" Grid.Column="0">EAN13 Enabled</Label>
            <RadioButton Name="Ean13EnableRadioButton" Style="{StaticResource SettingsRadioButton}" Grid.Column="1" IsChecked="{Binding Path=Ean13Enabled, Converter={StaticResource boolInverterConverter}, ConverterParameter=true, Mode=TwoWay}">On</RadioButton>
            <RadioButton Name="Ean13DisableRadionButton" Style="{StaticResource SettingsRadioButton}" Grid.Column="2" IsChecked="{Binding Path=Ean13Enabled, Converter={StaticResource boolInverterConverter}, ConverterParameter=false, Mode=TwoWay}">Off</RadioButton>
          </Grid>
        </Border>
        <Border Style="{StaticResource DefaultBorderStyle}">
          <Grid Name="EanBooklandEnabledGrid">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*" />
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Label Name="EanBooklandEnabledLabel" Style="{StaticResource SettingsLabel}" Grid.Column="0">
              <ContentControl.Content>
                <TextBlock TextWrapping="Wrap">EAN Bookland Enabled</TextBlock>
              </ContentControl.Content>
            </Label>
            <RadioButton Name="EanBooklandEnableRadioButton" Style="{StaticResource SettingsRadioButton}" Grid.Column="1" IsChecked="{Binding Path=EanBooklandEnabled, Converter={StaticResource boolInverterConverter}, ConverterParameter=true, Mode=TwoWay}">On</RadioButton>
            <RadioButton Name="EanBooklandDisableRadionButton" Style="{StaticResource SettingsRadioButton}" Grid.Column="2" IsChecked="{Binding Path=EanBooklandEnabled, Converter={StaticResource boolInverterConverter}, ConverterParameter=false, Mode=TwoWay}">Off</RadioButton>
          </Grid>
        </Border>
        <Border Style="{StaticResource DefaultBorderStyle}">
          <Grid Name="SupplementalModeGrid">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Label Name="SupplementalModeLabel" Style="{StaticResource SettingsLabel}" Grid.Column="0">
              <ContentControl.Content>
                <TextBlock TextWrapping="Wrap">Supplemental Mode</TextBlock>
              </ContentControl.Content>
            </Label>
            <userControls:CustomSettingsSlider x:Name="SupplementalModeSettingsSlider" MinimumValue="0" MaximumValue="12" Grid.Column="1" HorizontalSliderValue="{Binding Path=SupplementalMode, Mode=TwoWay}" />
          </Grid>
        </Border>
        <Border Style="{StaticResource DefaultBorderStyle}">
          <Grid Name="SupplementalRedundancyGrid">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Label Name="SupplementalRedundancyLabel" Style="{StaticResource SettingsLabel}" Grid.Column="0">
              <ContentControl.Content>
                <TextBlock TextWrapping="Wrap">Supplemental Redundancy</TextBlock>
              </ContentControl.Content>
            </Label>
            <userControls:CustomSettingsSlider x:Name="SupplementalRedundancySettingsSlider" MinimumValue="2" MaximumValue="12" Grid.Column="1" HorizontalSliderValue="{Binding Path=SupplementalRedundancy, Mode=TwoWay}" />
          </Grid>
        </Border>
        <Border Style="{StaticResource DefaultBorderStyle}">
          <Grid Name="UpcaCheckDigTransEnabledGrid">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*" />
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Label Name="UpcaCheckDigTransEnabledLabel" Style="{StaticResource SettingsLabel}" Grid.Column="0">
              <ContentControl.Content>
                <TextBlock TextWrapping="Wrap">UPCA Check Digits Transmission</TextBlock>
              </ContentControl.Content>
            </Label>
            <RadioButton Name="UpcaCheckDigTransEnableRadioButton" Style="{StaticResource SettingsRadioButton}" Grid.Column="1" IsChecked="{Binding Path=UpcaDigitsTransmissionEnabled, Converter={StaticResource boolInverterConverter}, ConverterParameter=true, Mode=TwoWay}">On</RadioButton>
            <RadioButton Name="UpcaCheckDigTransDisableRadionButton" Style="{StaticResource SettingsRadioButton}" Grid.Column="2" IsChecked="{Binding Path=UpcaDigitsTransmissionEnabled, Converter={StaticResource boolInverterConverter}, ConverterParameter=false, Mode=TwoWay}">Off</RadioButton>
          </Grid>
        </Border>
        <Border Style="{StaticResource DefaultBorderStyle}">
          <Grid Name="UpceCheckDigTransEnabledGrid">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*" />
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Label Name="UpceCheckDigTransEnabledLabel" Style="{StaticResource SettingsLabel}" Grid.Column="0">
              <ContentControl.Content>
                <TextBlock TextWrapping="Wrap">UPCE Check Digits Transmission</TextBlock>
              </ContentControl.Content>
            </Label>
            <RadioButton Name="UpceCheckDigTransEnableRadioButton" Style="{StaticResource SettingsRadioButton}" Grid.Column="1" IsChecked="{Binding Path=UpceDigitsTransmissionEnabled, Converter={StaticResource boolInverterConverter}, ConverterParameter=true, Mode=TwoWay}">On</RadioButton>
            <RadioButton Name="UpceCheckDigTransDisableRadionButton" Style="{StaticResource SettingsRadioButton}" Grid.Column="2" IsChecked="{Binding Path=UpceDigitsTransmissionEnabled, Converter={StaticResource boolInverterConverter}, ConverterParameter=false, Mode=TwoWay}">Off</RadioButton>
          </Grid>
        </Border>
        <Border Style="{StaticResource DefaultBorderStyle}">
          <Grid Name="Upce1CheckDigTransEnabledGrid">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*" />
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Label Name="Upce1CheckDigTranEnabledLabel" Style="{StaticResource SettingsLabel}" Grid.Column="0">
              <ContentControl.Content>
                <TextBlock TextWrapping="Wrap">UPCE1 Check Digits Transmission</TextBlock>
              </ContentControl.Content>
            </Label>
            <RadioButton Name="Upce1CheckDigTranEnableRadioButton" Style="{StaticResource SettingsRadioButton}" Grid.Column="1" IsChecked="{Binding Path=Upce1DigitsTransmissionEnabled, Converter={StaticResource boolInverterConverter}, ConverterParameter=true, Mode=TwoWay}">On</RadioButton>
            <RadioButton Name="Upce1CheckDigTranDisableRadionButton" Style="{StaticResource SettingsRadioButton}" Grid.Column="2" IsChecked="{Binding Path=Upce1DigitsTransmissionEnabled, Converter={StaticResource boolInverterConverter}, ConverterParameter=false, Mode=TwoWay}">Off</RadioButton>
          </Grid>
        </Border>
        <Border Style="{StaticResource DefaultBorderStyle}">
          <Grid Name="UpcaPreambleGrid">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Label Name="UpcaPreambleModeLabel" Style="{StaticResource SettingsLabel}" Grid.Column="0">
              <ContentControl.Content>
                <TextBlock TextWrapping="Wrap">UPCA Preamble Mode</TextBlock>
              </ContentControl.Content>
            </Label>
            <ComboBox Name="UpcaPreambleModeComboBox" Margin="5" VerticalContentAlignment="Center" VerticalAlignment="Center" SelectedValuePath="Key" DisplayMemberPath="Value" FontSize="15px" Grid.Column="1" ItemsSource="{Binding Source={StaticResource apiEnumAlias}, Path=UpcPreambleTransmissionModeAliases}" SelectedValue="{Binding Path=UpcaPreamble}">
              <ItemsControl.ItemContainerStyle>
                <Style TargetType="{x:Type ComboBoxItem}">
                  <Setter Property="FontSize" Value="20px" />
                </Style>
              </ItemsControl.ItemContainerStyle>
            </ComboBox>
          </Grid>
        </Border>
        <Border Style="{StaticResource DefaultBorderStyle}">
          <Grid Name="UpcePreambleGrid">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Label Name="UpcePreambleModeLabel" Style="{StaticResource SettingsLabel}" Grid.Column="0">
              <ContentControl.Content>
                <TextBlock TextWrapping="Wrap">UPCE Preamble Mode</TextBlock>
              </ContentControl.Content>
            </Label>
            <ComboBox Name="UpcePreambleModeComboBox" Margin="5" VerticalContentAlignment="Center" VerticalAlignment="Center" SelectedValuePath="Key" DisplayMemberPath="Value" FontSize="15px" Grid.Column="1" ItemsSource="{Binding Source={StaticResource apiEnumAlias}, Path=UpcPreambleTransmissionModeAliases}" SelectedValue="{Binding Path=UpcePreamble}">
              <ItemsControl.ItemContainerStyle>
                <Style TargetType="{x:Type ComboBoxItem}">
                  <Setter Property="FontSize" Value="20px" />
                </Style>
              </ItemsControl.ItemContainerStyle>
            </ComboBox>
          </Grid>
        </Border>
        <Border Style="{StaticResource DefaultBorderStyle}">
          <Grid Name="Upce1PreambleGrid">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Label Name="Upce1PreambleModeLabel" Style="{StaticResource SettingsLabel}" Grid.Column="0">
              <ContentControl.Content>
                <TextBlock TextWrapping="Wrap">UPCE1 Preamble Mode</TextBlock>
              </ContentControl.Content>
            </Label>
            <ComboBox Name="Upce1PreambleModeComboBox" Margin="5" VerticalContentAlignment="Center" VerticalAlignment="Center" SelectedValuePath="Key" DisplayMemberPath="Value" FontSize="15px" Grid.Column="1" ItemsSource="{Binding Source={StaticResource apiEnumAlias}, Path=UpcPreambleTransmissionModeAliases}" SelectedValue="{Binding Path=Upce1Preamble}">
              <ItemsControl.ItemContainerStyle>
                <Style TargetType="{x:Type ComboBoxItem}">
                  <Setter Property="FontSize" Value="20px" />
                </Style>
              </ItemsControl.ItemContainerStyle>
            </ComboBox>
          </Grid>
        </Border>
        <Border Style="{StaticResource DefaultBorderStyle}">
          <Grid Name="CouponCodeEnabledGrid">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*" />
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Label Name="CouponCodeEnabledLabel" Style="{StaticResource SettingsLabel}" Grid.Column="0">
              <ContentControl.Content>
                <TextBlock TextWrapping="Wrap">Coupon Code</TextBlock>
              </ContentControl.Content>
            </Label>
            <RadioButton Name="CouponCodeEnableRadioButton" Style="{StaticResource SettingsRadioButton}" Grid.Column="1" IsChecked="{Binding Path=CouponCodeEnabled, Converter={StaticResource boolInverterConverter}, ConverterParameter=true, Mode=TwoWay}">On</RadioButton>
            <RadioButton Name="CouponCodeDisableRadionButton" Style="{StaticResource SettingsRadioButton}" Grid.Column="2" IsChecked="{Binding Path=CouponCodeEnabled, Converter={StaticResource boolInverterConverter}, ConverterParameter=false, Mode=TwoWay}">Off</RadioButton>
          </Grid>
        </Border>
        <Border Style="{StaticResource DefaultBorderStyle}">
          <Grid Name="UpceToUpcaEnabledGrid">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*" />
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Label Name="UpceToUpcaEnabledLabel" Style="{StaticResource SettingsLabel}" Grid.Column="0">
              <ContentControl.Content>
                <TextBlock TextWrapping="Wrap">UPCE To UPCA Conversion</TextBlock>
              </ContentControl.Content>
            </Label>
            <RadioButton Name="UpceToUpcaEnableRadioButton" Style="{StaticResource SettingsRadioButton}" Grid.Column="1" IsChecked="{Binding Path=UpceToUpcaEnabled, Converter={StaticResource boolInverterConverter}, ConverterParameter=true, Mode=TwoWay}">On</RadioButton>
            <RadioButton Name="UpceToUpcaDisableRadionButton" Style="{StaticResource SettingsRadioButton}" Grid.Column="2" IsChecked="{Binding Path=UpceToUpcaEnabled, Converter={StaticResource boolInverterConverter}, ConverterParameter=false, Mode=TwoWay}">Off</RadioButton>
          </Grid>
        </Border>
        <Border Style="{StaticResource DefaultBorderStyle}">
          <Grid Name="Upce1ToUpcaEnabledGrid">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*" />
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Label Name="Upce1ToUpcaEnabledLabel" Style="{StaticResource SettingsLabel}" Grid.Column="0">
              <ContentControl.Content>
                <TextBlock TextWrapping="Wrap">UPCE1 To UPCA Conversion</TextBlock>
              </ContentControl.Content>
            </Label>
            <RadioButton Name="Upce1ToUpcaEnableRadioButton" Style="{StaticResource SettingsRadioButton}" Grid.Column="1" IsChecked="{Binding Path=Upce1ToUpcaEnabled, Converter={StaticResource boolInverterConverter}, ConverterParameter=true, Mode=TwoWay}">On</RadioButton>
            <RadioButton Name="Upce1ToUpcaDisableRadionButton" Style="{StaticResource SettingsRadioButton}" Grid.Column="2" IsChecked="{Binding Path=Upce1ToUpcaEnabled, Converter={StaticResource boolInverterConverter}, ConverterParameter=false, Mode=TwoWay}">Off</RadioButton>
          </Grid>
        </Border>
        <Border Style="{StaticResource DefaultBorderStyle}">
          <Grid Name="Ean8ZerosEnabledGrid">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*" />
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Label Name="Ean8ZerosEnabledLabel" Style="{StaticResource SettingsLabel}" Grid.Column="0">
              <ContentControl.Content>
                <TextBlock TextWrapping="Wrap">EAN 8 Zeros Extension</TextBlock>
              </ContentControl.Content>
            </Label>
            <RadioButton Name="Ean8ZerosEnableRadioButton" Style="{StaticResource SettingsRadioButton}" Grid.Column="1" IsChecked="{Binding Path=Ean8ZerosEnabled, Converter={StaticResource boolInverterConverter}, ConverterParameter=true, Mode=TwoWay}">On</RadioButton>
            <RadioButton Name="Ean8ZerosDisableRadionButton" Style="{StaticResource SettingsRadioButton}" Grid.Column="2" IsChecked="{Binding Path=Ean8ZerosEnabled, Converter={StaticResource boolInverterConverter}, ConverterParameter=false, Mode=TwoWay}">Off</RadioButton>
          </Grid>
        </Border>
        <Border Style="{StaticResource DefaultBorderStyle}">
          <Grid Name="Ean8ToEan13EnabledGrid">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*" />
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Label Name="Ean8ToEan13EnabledLabel" Style="{StaticResource SettingsLabel}" Grid.Column="0">
              <ContentControl.Content>
                <TextBlock TextWrapping="Wrap">EAN 8 To EAN 13 Conversion</TextBlock>
              </ContentControl.Content>
            </Label>
            <RadioButton Name="Ean8ToEan13EnableRadioButton" Style="{StaticResource SettingsRadioButton}" Grid.Column="1" IsChecked="{Binding Path=Ean8ToEan13Enabled, Converter={StaticResource boolInverterConverter}, ConverterParameter=true, Mode=TwoWay}">On</RadioButton>
            <RadioButton Name="Ean8ToEan13DisableRadionButton" Style="{StaticResource SettingsRadioButton}" Grid.Column="2" IsChecked="{Binding Path=Ean8ToEan13Enabled, Converter={StaticResource boolInverterConverter}, ConverterParameter=false, Mode=TwoWay}">Off</RadioButton>
          </Grid>
        </Border>
      </StackPanel>
      <Button Name="BackButton" VerticalAlignment="Bottom" Style="{StaticResource LargeButton}" Grid.Row="1" Click="BackButton_Click">Back</Button>
    </Grid>
  </ScrollViewer>
</barcodes:BaseBarcodeView>