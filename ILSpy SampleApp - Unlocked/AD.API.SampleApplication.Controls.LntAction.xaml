<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="AD.API.SampleApplication.Controls.LntAction" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Height="400" Width="300" WindowStyle="None" ShowInTaskbar="False" ResizeMode="NoResize" BorderBrush="#FFFF0000" BorderThickness="5" WindowStartupLocation="CenterOwner" xmlns:controls="clr-namespace:AD.API.SampleApplication.Controls;assembly=AD.API.SampleApplication" Title="{Binding Path=ErrorCaption}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock TextAlignment="Center" TextWrapping="NoWrap" Background="#FFFF0000" Foreground="#FFFFFFFF" FontSize="18px" Grid.Row="0" Text="Resource Check" />
    <TextBlock TextWrapping="Wrap" Margin="40, 20" Grid.Row="1" FontSize="18px" Text="{Binding Path=MessageText}" />
    <UniformGrid Grid.Row="2" Columns="1">
      <Button Name="PrintButton" FontSize="30px" Margin="40, 5" Click="PrintButton_Click">Print</Button>
      <Button Name="DeleteButton" FontSize="30px" Margin="40, 5" Click="DeleteButton_Click">Delete</Button>
      <Button Name="IgnoreButton" FontSize="30px" Margin="40, 5" Click="IgnoreButton_Click">Cancel</Button>
    </UniformGrid>
  </Grid>
</Window>