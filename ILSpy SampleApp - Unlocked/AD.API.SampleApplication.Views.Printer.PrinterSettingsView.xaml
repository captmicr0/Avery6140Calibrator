<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="AD.API.SampleApplication.Views.Printer.PrinterSettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:tools="clr-namespace:AD.API.SampleApplication.Tools" xmlns:userControls="clr-namespace:AD.API.SampleApplication.Controls.UserControls" Title="PrinterSettingsView" xmlns:printer="clr-namespace:AD.API.SampleApplication.Views.Printer">
  <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly" IsEnabled="{Binding Path=IsActionAvailable}">
    <Grid Margin="20">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <StackPanel Orientation="Vertical" Grid.Column="0">
        <Border Style="{StaticResource DefaultBorderStyle}">
          <Grid Name="VersionGrid">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Label Name="VersionLabel" Style="{StaticResource SettingsLabel}" Grid.Column="0">Version:</Label>
            <Label Name="VersionValueLabel" Style="{StaticResource SettingsLabel}" HorizontalAlignment="Center" Grid.Column="1" Content="{Binding Path=PrinterVersion, Mode=OneWay}" />
          </Grid>
        </Border>
        <Border Style="{StaticResource DefaultBorderStyle}">
          <Grid Name="SupplyTypeGrid">
            <FrameworkElement.Resources>
              <ResourceDictionary>
                <tools:EnumBooleanConverter x:Key="enumBooleanConverter" />
              </ResourceDictionary>
            </FrameworkElement.Resources>
            <Grid.RowDefinitions>
              <RowDefinition />
              <RowDefinition />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Label Name="SupplyTypeLabel" Style="{StaticResource SettingsLabel}" Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="3">Supply Type</Label>
            <RadioButton Name="BlackMarkRadioButton" Grid.Row="1" Grid.Column="0" Style="{StaticResource SettingsRadioButton}" Margin="10, 5, 0, 5" IsChecked="{Binding Path=PrinterSupplyType, Converter={StaticResource enumBooleanConverter}, ConverterParameter=BlackMark}">BlackMark</RadioButton>
            <RadioButton Name="LineModeRadioButton" Grid.Column="1" Grid.Row="1" Style="{StaticResource SettingsRadioButton}" Margin="10, 5, 0, 5" IsChecked="{Binding Path=PrinterSupplyType, Converter={StaticResource enumBooleanConverter}, ConverterParameter=NonIndexLineMode}">LineMode</RadioButton>
            <RadioButton Name="NoneRadioButton" Grid.Column="2" Grid.Row="1" Style="{StaticResource SettingsRadioButton}" IsChecked="{Binding Path=PrinterSupplyType, Converter={StaticResource enumBooleanConverter}, ConverterParameter=NonIndex}">None</RadioButton>
          </Grid>
        </Border>
        <Border Style="{StaticResource DefaultBorderStyle}">
          <Grid Name="ContrastSettingsGrid">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Label Name="ContrastLabel" Grid.Column="0" Style="{StaticResource SettingsLabel}">
              <ContentControl.Content>
                <TextBlock TextWrapping="Wrap">Contrast</TextBlock>
              </ContentControl.Content>
            </Label>
            <userControls:CustomSettingsSlider x:Name="ContrastCustomSlider" Grid.Column="1" MaximumValue="100" MinimumValue="-100" HorizontalSliderValue="{Binding Path=PrinterContrast, Mode=TwoWay}" />
          </Grid>
        </Border>
        <Border Style="{StaticResource DefaultBorderStyle}">
          <Grid Name="SupplyPositionSettingsGrid">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Label Name="SupplyPositionLabel" Grid.Column="0" Style="{StaticResource SettingsLabel}">
              <ContentControl.Content>
                <TextBlock TextWrapping="Wrap">Supply position</TextBlock>
              </ContentControl.Content>
            </Label>
            <userControls:CustomSettingsSlider x:Name="SupplyPositionCustomSlider" Grid.Column="1" MaximumValue="99" MinimumValue="-99" HorizontalSliderValue="{Binding Path=PrinterSupplyPossition, Mode=TwoWay}" />
          </Grid>
        </Border>
        <Border Style="{StaticResource DefaultBorderStyle}">
          <Grid Name="MaxLengthSettingsGrid">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Label Name="MaxLengthLabel" Grid.Column="0" Style="{StaticResource SettingsLabel}">
              <ContentControl.Content>
                <TextBlock TextWrapping="Wrap">Max length</TextBlock>
              </ContentControl.Content>
            </Label>
            <userControls:CustomSettingsSlider x:Name="MaxLengthCustomSlider" Grid.Column="1" MaximumValue="16" MinimumValue="2" HorizontalSliderValue="{Binding Path=PrinterMaxLength, Mode=TwoWay}" />
          </Grid>
        </Border>
        <Border Style="{StaticResource DefaultBorderStyle}">
          <Grid Name="VerticalAdjustSettingsGrid">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Label Name="VerticalAdjustLabel" Grid.Column="0" Style="{StaticResource SettingsLabel}">
              <ContentControl.Content>
                <TextBlock TextWrapping="Wrap">Vertical adjust</TextBlock>
              </ContentControl.Content>
            </Label>
            <userControls:CustomSettingsSlider x:Name="VerticalAdjustCustomSlider" Grid.Column="1" MaximumValue="99" MinimumValue="-99" HorizontalSliderValue="{Binding Path=PrinterVerticalAdjust, Mode=TwoWay}" />
          </Grid>
        </Border>
        <Border Style="{StaticResource DefaultBorderStyle}">
          <Grid Name="HorizontalAdjustSettingsGrid">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Label Name="HorizontalAdjustLabel" Grid.Column="0" Style="{StaticResource SettingsLabel}">
              <ContentControl.Content>
                <TextBlock TextWrapping="Wrap">Horizontal adjust</TextBlock>
              </ContentControl.Content>
            </Label>
            <userControls:CustomSettingsSlider x:Name="HorizontalAdjustCustomSlider" Grid.Column="1" MaximumValue="99" MinimumValue="-99" HorizontalSliderValue="{Binding Path=PrinterHorizontalAdjust, Mode=TwoWay}" />
          </Grid>
        </Border>
        <Border Style="{StaticResource DefaultBorderStyle}">
          <Grid Name="BackDistanceSettingsGrid">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Label Name="BackDistanceLabel" Grid.Column="0" Style="{StaticResource SettingsLabel}">
              <ContentControl.Content>
                <TextBlock TextWrapping="Wrap">Back distance</TextBlock>
              </ContentControl.Content>
            </Label>
            <userControls:CustomSettingsSlider x:Name="BackDistanceCustomSlider" IsEnabled="False" Grid.Column="1" MaximumValue="255" MinimumValue="0" HorizontalSliderValue="{Binding Path=PrinterBackDistance, Mode=TwoWay}" />
          </Grid>
        </Border>
        <Border Style="{StaticResource DefaultBorderStyle}">
          <Grid Name="OverfeedDistanceSettingsGrid">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Label Name="OverfeedDistanceLabel" Grid.Column="0" Style="{StaticResource SettingsLabel}">
              <ContentControl.Content>
                <TextBlock TextWrapping="Wrap">Overfeed distance</TextBlock>
              </ContentControl.Content>
            </Label>
            <userControls:CustomSettingsSlider x:Name="OverfeedDistanceCustomSlider" IsEnabled="False" Grid.Column="1" MaximumValue="255" MinimumValue="0" HorizontalSliderValue="{Binding Path=PrinterOverFeedDistance, Mode=TwoWay}" />
          </Grid>
        </Border>
        <Border Style="{StaticResource DefaultBorderStyle}">
          <Grid Name="SpeedEnergySettingsGrid">
            <FrameworkElement.Resources>
              <ResourceDictionary>
                <tools:EnumBooleanConverter x:Key="enumBooleanConverter" />
              </ResourceDictionary>
            </FrameworkElement.Resources>
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition />
              <RowDefinition />
            </Grid.RowDefinitions>
            <Label Name="SpeedLabel" Grid.Column="0" Grid.Row="0" Style="{StaticResource SettingsLabel}">Speed</Label>
            <Grid Row="0" Column="1" ColumnSpan="2" Margin="20, 0, 20, 0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Button Name="DecreaseButton" Grid.Column="0" FontSize="25px" FontWeight="Bold" Width="40" HorizontalContentAlignment="Center" HorizontalAlignment="Right" VerticalContentAlignment="Center" Height="40" Style="{StaticResource ImageButton}" Padding="0, 0, 0, 10" Command="{Binding Path=DecreaseSpeedCommand}">-</Button>
              <Label Name="IndicatorLabel" Grid.Column="1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="18px" Margin="10, 0, 10, 0" Content="{Binding Path=PrinterSpeed}" />
              <Button Name="IncreaseButton" Grid.Column="2" FontSize="25px" FontWeight="Bold" Width="40" HorizontalContentAlignment="Center" HorizontalAlignment="Left" VerticalContentAlignment="Center" Height="40" Style="{StaticResource ImageButton}" Padding="0, 0, 0, 10" Command="{Binding Path=IncreaseSpeedCommand}">+</Button>
            </Grid>
            <Label Name="EnergyLabel" Grid.Column="0" Grid.Row="1" Style="{StaticResource SettingsLabel}">Energy</Label>
            <RadioButton Name="StandardEnergyRadioButton" Grid.Column="1" Grid.Row="1" Style="{StaticResource SettingsRadioButton}" IsChecked="{Binding Path=PrinterEnergyType, Converter={StaticResource enumBooleanConverter}, ConverterParameter=Standard}">Standard</RadioButton>
            <RadioButton Name="HighEnergyRadioButton" Grid.Column="2" Grid.Row="1" Style="{StaticResource SettingsRadioButton}" IsChecked="{Binding Path=PrinterEnergyType, Converter={StaticResource enumBooleanConverter}, ConverterParameter=High}">High</RadioButton>
          </Grid>
        </Border>
        <Border Style="{StaticResource DefaultBorderStyle}">
          <Grid Name="ModeSettingsGrid">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition />
              <RowDefinition />
            </Grid.RowDefinitions>
            <CheckBox Name="BackFeedCheckBox" IsEnabled="False" Grid.Column="0" Grid.Row="0" VerticalContentAlignment="Center" HorizontalAlignment="Left" FontSize="15px" Margin="10, 5, 5, 5" IsChecked="{Binding Path=PrinterBackFeedMode}">Back Feed</CheckBox>
            <CheckBox Name="OverFeedCheckBox" IsEnabled="False" Grid.Column="1" Grid.Row="0" VerticalContentAlignment="Center" HorizontalAlignment="Left" FontSize="15px" Margin="5, 5, 5, 5" IsChecked="{Binding Path=PrinterOverFeed}">Over Feed</CheckBox>
            <CheckBox Name="LineModeCheckBox" Grid.Column="0" Grid.Row="1" VerticalContentAlignment="Center" HorizontalAlignment="Left" FontSize="15px" Margin="10, 5, 5, 5" IsChecked="{Binding Path=PrinterNoneIndexLineMode}">Line Mode</CheckBox>
            <CheckBox Name="OnBlackMarkCheckBox" IsEnabled="False" Grid.Column="1" Grid.Row="1" VerticalContentAlignment="Center" HorizontalAlignment="Left" FontSize="15px" Margin="5, 5, 5, 5" IsChecked="{Binding Path=PrinterOnBlackMark, Mode=OneWay}">On Black Mark</CheckBox>
          </Grid>
        </Border>
        <Border Style="{StaticResource DefaultBorderStyle}">
          <Grid Name="StatusGrid">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Label Name="StatusLabel" Grid.Column="0" Style="{StaticResource SettingsLabel}">Status</Label>
            <Label Name="StatusTextBox" Grid.Column="1" IsEnabled="False" FontSize="15px" Margin="10, 5, 10, 5" Content="{Binding Path=PrinterStatus, Mode=OneWay}" />
          </Grid>
        </Border>
      </StackPanel>
      <DockPanel Grid.Row="1" Dock="Bottom" VerticalAlignment="Bottom">
        <Button Name="BtnGoToBlack" DockPanel.Dock="Bottom" Style="{StaticResource LargeButton}" Click="BtnGoToBlack_Click">Back</Button>
        <Button Name="BtnReset" DockPanel.Dock="Bottom" Style="{StaticResource LargeButton}" FontSize="20px" Command="{Binding Path=ResetToDefaultCommand}">Reset settings</Button>
      </DockPanel>
    </Grid>
  </ScrollViewer>
</Page>